# Copy to .env in the project root (backend also reads backend/.env) and frontend/.env.local for the frontend vars.
# NEVER commit real values.

# --- Anthropic (group key, $2 limit; do not share outside the group) ---
ANTHROPIC_API_KEY=
MODEL_NAME=claude-haiku-5-5
# USD per 1M tokens, copy from the Anthropic console pricing; used for the budget ledger
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
BUDGET_SOFT_USD=1.40
BUDGET_HARD_USD=1.90

# --- Supabase Postgres: use the SESSION POOLER string (IPv4), not the direct one ---
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent ---
DEFAULT_STORE_SLUG=nazakat-threads
CORS_ORIGINS=http://localhost:3000,https://<your-app>.vercel.app
RATE_LIMIT_PER_MIN=30
# 1 = fake model for free local dev (no API spend)
FAKE_LLM=0

# --- Seller notifications (optional until you have a bot) ---
TELEGRAM_BOT_TOKEN=
SEED_TELEGRAM_CHAT_ID=

# --- Frontend (Vercel env vars / frontend/.env.local) ---
NEXT_PUBLIC_API_BASE=http://localhost:7860
NEXT_PUBLIC_DEFAULT_STORE=nazakat-threads
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# optional: same Haiku prices as above, shows token cost on the dashboard overview
NEXT_PUBLIC_PRICE_IN_PER_MTOK=
NEXT_PUBLIC_PRICE_OUT_PER_MTOK=
